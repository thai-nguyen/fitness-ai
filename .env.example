# Copy to .env (gitignored) and adjust. Do not commit real secrets or private LAN endpoints.

# --- Backend ---
APP_NAME=fitness-ai-backend
APP_ENV=development
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Sync SQLAlchemy URL (psycopg v3). Host port 15432 is project-specific (see infrastructure/docker-compose.yml).
# Note: avoid Windows Hyper-V excluded ranges (e.g. ~55xxx) when choosing host ports.
DATABASE_URL=postgresql+psycopg://fitness:fitness_dev_only@127.0.0.1:15432/fitness_ai

# --- AI provider (M05 POC; LAN endpoint only in ignored local .env — never commit private IPs) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
AI_CONNECT_TIMEOUT_SECONDS=5
AI_READ_TIMEOUT_SECONDS=120
AI_TOTAL_TIMEOUT_SECONDS=180
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_CONTEXT_TOKENS=4096
AI_MAX_REPAIR_ATTEMPTS=1
AI_MAX_CONCURRENT_REQUESTS=1
AI_TEMPERATURE=0.2
# Dev-only POC HTTP/SSE surfaces (default off). Do not enable in production.
AI_POC_ENABLED=false


# --- Mobile (pass via --dart-define; not loaded from this file by Flutter) ---
# Android emulator -> host machine: http://10.0.2.2:8080
# Physical device -> host LAN IP (your machine, not necessarily the Ollama host): http://HOST_LAN_IP:8080
# Windows desktop local: http://127.0.0.1:8080
# API_BASE_URL=http://10.0.2.2:8080
